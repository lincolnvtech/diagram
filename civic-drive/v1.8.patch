+        if(!cached.isEmpty())result.setText("Última leitura guardada:\n\n"+cached);
+    }
+    private void read(){
+        if(running)return;
+        ObdManager obd=ObdManager.shared();
+        if(obd==null||!obd.isActive()){
+            new AlertDialog.Builder(this).setTitle("OBD2 desconectado")
+                    .setMessage("Volte à tela inicial, selecione ou conecte o adaptador ELM327 e tente novamente. Feche o Torque Pro para não disputar o Bluetooth.")
+                    .setPositiveButton("Entendi",null).show();return;
+        }
+        boolean accepted=obd.requestFaultRead(text->{
+            if(isFinishing()||isDestroyed())return;
+            running=false;refresh.setText("LER NOVAMENTE");
+            String time=DateFormat.getDateTimeInstance(DateFormat.SHORT,DateFormat.SHORT).format(new Date());
+            String summary=time+"\n"+text;
+            result.setText(summary);
+            getSharedPreferences("civic_faults",MODE_PRIVATE).edit().putString("summary",summary).apply();
+        });
+        if(accepted){running=true;refresh.setText("CONSULTANDO…");result.setText("Consultando os módulos OBD2…\nAguarde as respostas da ECU.");}
+        else result.setText("Consulta já em andamento. Aguarde ou volte à home.");
+    }
+    private TextView text(String s,int size){TextView t=new TextView(this);t.setText(s);t.setTextSize(size);t.setTextColor(Color.WHITE);t.setTypeface(Typeface.DEFAULT,Typeface.BOLD);return t;}
+}
