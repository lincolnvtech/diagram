diff -ruN '--exclude=*.orig' '--exclude=*.webp' civic196baseline/app/src/main/java/br/com/civicdrive/GearEstimator.java civic196build/app/src/main/java/br/com/civicdrive/GearEstimator.java
--- civic196baseline/app/src/main/java/br/com/civicdrive/GearEstimator.java	1970-01-01 00:00:00.000000000 +0000
+++ civic196build/app/src/main/java/br/com/civicdrive/GearEstimator.java	2026-11-20 19:16:04.867686914 +0000
@@ -0,0 +1,45 @@
+package br.com.civicdrive;
+
+/** Marcha PROVAVEL: cálculo somente local, não é a posição real do seletor PRND.
+ * Relações retiradas de Honda Brasil, informações técnicas Civic 2011 5AT.
+ * Rodas originais: 205/55R16. A patinação do conversor pode invalidar a leitura.
+ */
+public final class GearEstimator {
+    private static final double[] GEARS = {2.666, 1.534, 1.021, 0.720, 0.524};
+    private static final double FINAL = 4.437;
+    private static final double DIAMETER_M = (16d*25.4d+2d*205d*0.55d)/1000d;
+    private static final double WHEEL_RPM_PER_KMH = 1000d/(Math.PI*DIAMETER_M*60d);
+    private int candidate = 0, count = 0, last = 0;
+    private int lastScore = 0;
+    private long lastAt = 0;
+    public static final class Result {
+        public final int gear, confidence;
+        private Result(int gear,int confidence){this.gear=gear;this.confidence=confidence;}
+    }
+    /** Requer marcha consistente por 3 amostras, velocidade e giro válidos. */
+    public Result update(double rpm, double kmh, long timestamp) {
+        if (timestamp-lastAt>16000 || timestamp<lastAt) {candidate=0;count=0;last=0;}
+        lastAt=timestamp;
+        if (!Double.isFinite(rpm)||!Double.isFinite(kmh)||rpm<850||rpm>6900||kmh<22||kmh>210) {
+            candidate=0;count=0;last=0;lastScore=0;return new Result(0,0);
+        }
+        double actual=rpm/kmh, bestError=Double.MAX_VALUE, secondError=Double.MAX_VALUE;
+        int best=0;
+        for(int i=0;i<GEARS.length;i++){
+            double expected=GEARS[i]*FINAL*WHEEL_RPM_PER_KMH;
+            double err=Math.abs(actual-expected)/expected;
+            if(err<bestError){secondError=bestError;bestError=err;best=i+1;}
+            else if(err<secondError)secondError=err;
+        }
+        // Alta velocidade exige correspondência mais restrita; nenhuma marcha
+        // deve ser apresentada quando há patinação forte do conversor.
+        double tolerance=kmh<40 ? .16 : .115;
+        if(bestError>tolerance || secondError-bestError<.095){
+            candidate=0;count=0;last=0;lastScore=0;return new Result(0,0);
+        }
+        int score=Math.max(0,Math.min(99,(int)Math.round(98-bestError*270)));
+        if(best!=candidate){candidate=best;count=1;last=0;}else count=Math.min(20,count+1);
+        if(count>=3) {last=best;lastScore=score;}
+        return new Result(last,last==0?0:lastScore);
+    }
+}
